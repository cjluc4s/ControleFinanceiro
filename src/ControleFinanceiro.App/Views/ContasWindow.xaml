<Window x:Class="ControleFinanceiro.App.Views.ContasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar Contas" Height="480" Width="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Adicionar" Width="100" Margin="0,0,8,0" Command="{Binding AdicionarCommand}"/>
            <Button Content="Editar" Width="100" Margin="0,0,8,0" Command="{Binding EditarCommand}"/>
            <Button Content="Excluir" Width="100" Command="{Binding ExcluirCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Contas}" SelectedItem="{Binding ContaSelecionada}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="110"/>
                <DataGridTextColumn Header="Saldo Inicial" Binding="{Binding SaldoInicial, StringFormat={}{0:C2}}" Width="120"/>
                <DataGridTextColumn Header="Saldo Atual" Binding="{Binding SaldoAtual, StringFormat={}{0:C2}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Fechar" Width="90" Click="Fechar_Click"/>
        </StackPanel>
    </Grid>
</Window>
