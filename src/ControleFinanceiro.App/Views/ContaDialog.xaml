<Window x:Class="ControleFinanceiro.App.Views.ContaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conta" Height="280" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nome" Margin="0,0,0,4"/>
        <TextBox x:Name="TextNome" Grid.Row="0" Margin="0,20,0,12"/>

        <TextBlock Grid.Row="1" Text="Tipo" Margin="0,0,0,4"/>
        <ComboBox x:Name="ComboTipo" Grid.Row="1" Margin="0,20,0,12"/>

        <TextBlock Grid.Row="2" Text="Saldo inicial" Margin="0,0,0,4"/>
        <TextBox x:Name="TextSaldoInicial" Grid.Row="2" Margin="0,20,0,12"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="Cancelar_Click"/>
            <Button Content="Salvar" Width="90" IsDefault="True" Click="Salvar_Click"/>
        </StackPanel>
    </Grid>
</Window>
